# ==========================================
# BhuRakshak — Git Ignore Configuration
# ==========================================

# ------------------------------------------
# Python / Virtual Environment
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------
# Data Files — Raw Satellite & Weather Cache
# ------------------------------------------
# Satellite CSVs from GEE (hundreds of files, multi-GB total)
data/raw/satellite/*.csv

# Weather cache generated by align_timeseries.py
data/raw/weather_cache/

# Large raw landslide files (GeoJSON & intermediate CSVs)
data/raw/landslide/gsi_landslide_inventory_raw.geojson
data/raw/landslide/gsi_landslide_points_ner.csv

# ------------------------------------------
# Data Files — Processed Outputs
# ------------------------------------------
# Aligned dataset (~4 GB), label crosswalk, and any future outputs
data/processed/*.csv
data/processed/*.parquet

# ------------------------------------------
# Data Files — Shapefiles
# ------------------------------------------
data/shapefiles/**/*.shp
data/shapefiles/**/*.shx
data/shapefiles/**/*.dbf
data/shapefiles/**/*.prj
data/shapefiles/**/*.cpg

# ------------------------------------------
# Model Artifacts (future-proofing)
# ------------------------------------------
*.pt
*.pth
*.onnx
*.h5
checkpoints/
runs/
logs/
wandb/

# ------------------------------------------
# Jupyter Notebooks & Checkpoints
# ------------------------------------------
.ipynb_checkpoints/

# ------------------------------------------
# Credentials & Environment Variables
# ------------------------------------------
.env
*.pem
service_account.json
key.json
*.key

# ------------------------------------------
# IDE & System Files
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ------------------------------------------
# Legacy / NGDR download artifacts
# ------------------------------------------
ngdr_landslide_data/
gsi_landslide_shapefile/
satellite_timeseries_raw.csv
